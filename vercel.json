{
  "buildCommand": "pnpm run build --filter @workspace/weekly-local-tournament",
  "outputDirectory": "artifacts/weekly-local-tournament/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://YOUR_BACKEND_URL/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
