{
  "buildCommand": "cd artifacts/weekly-local-tournament && pnpm run build",
  "outputDirectory": "artifacts/weekly-local-tournament/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
